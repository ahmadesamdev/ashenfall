ASHENFALL_REPOSITORY=postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
PORT=3000
ASHENFALL_PG_POOL_SIZE=10

NODE_ENV=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Ashenfall <no-reply@example.com>

# SENDGRID_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Ashenfall <no-reply@example.com>

ASHENFALL_JWT_SECRET=

BCRYPT_ROUNDS=12

# ASHENFALL_ALLOWED_ORIGINS=https://play.example.com

# ASHENFALL_REPOSITORY=sqlite
# ASHENFALL_SQLITE_FILE=./data/ashenfall.sqlite
# TRUST_PROXY=1
# FORCE_HTTPS=true   # default in production: redirect http->https and send HSTS; set false only without TLS
# ASHENFALL_MAX_WS_CONNECTIONS=2000
# ASHENFALL_COMMANDS_PER_SECOND=10

# ASHENFALL_METRICS_TOKEN=
